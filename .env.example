# LLM used by the analyst and challenger agents.
# none      -> extractive mode: the advisor only returns retrieved provisions, no generated text
# anthropic -> requires ANTHROPIC_API_KEY
# openai    -> requires OPENAI_API_KEY
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Retrieval: bm25 (default, no extra dependencies) or hybrid (bm25 + chromadb vectors)
RETRIEVAL=bm25
# Embeddings for hybrid mode: chroma-default (local ONNX model) or openai
EMBEDDINGS=chroma-default
OPENAI_EMBED_MODEL=text-embedding-3-small

# Minimum BM25 score for a passage to count as evidence
MIN_PASSAGE_SCORE=1.0

# Storage
DATA_DIR=./data
